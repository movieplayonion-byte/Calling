<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08061F"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvCreateProfileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Your Profile"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCreateProfileSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add your photo and name so others recognize your calls"
            android:textColor="#A0A3BD"
            android:textSize="14sp"
            android:layout_marginBottom="28dp" />

        <ImageView
            android:id="@+id/ivProfilePhoto"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="#141136"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Profile Photo"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvSelectPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Tap to choose profile photo"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etProfileName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#141136"
            android:hint="Enter your full name"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6E7191"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etProfilePhone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#141136"
            android:hint="+91XXXXXXXXXX"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="#D6D8E7"
            android:textColorHint="#6E7191"
            android:textSize="16sp"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#00E5FF"
            android:text="Save &amp; Continue"
            android:textAllCaps="false"
            android:textColor="#08061F"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
