<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_dark">

    <!-- Remote Video Surface View Placeholder -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/surfaceRemoteVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Caller Info & Timer -->
    <TextView
        android:id="@+id/tvVideoPeerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:text="Vikram Singh"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvVideoTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text="04:32"
        android:textColor="@color/cyan_neon"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvVideoPeerName" />

    <!-- Local PiP Camera Preview (Top Right) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/surfaceLocalVideo"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_input_field"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Video Controls -->
    <LinearLayout
        android:id="@+id/layoutVideoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btnVideoEndCall">

        <ImageView
            android:id="@+id/btnSwitchCamera"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_circle_cyan_glow"
            android:padding="12dp"
            android:src="@drawable/ic_camera_switch" />

        <ImageView
            android:id="@+id/btnVideoOff"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_circle_cyan_glow"
            android:padding="12dp"
            android:src="@drawable/ic_video" />

        <ImageView
            android:id="@+id/btnVideoMute"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_circle_cyan_glow"
            android:padding="12dp"
            android:src="@drawable/ic_mic_off" />

        <ImageView
            android:id="@+id/btnVideoSpeaker"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_circle_cyan_glow"
            android:padding="12dp"
            android:src="@drawable/ic_speaker" />

    </LinearLayout>

    <ImageView
        android:id="@+id/btnVideoEndCall"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_circle_cyan_glow"
        android:padding="18dp"
        android:src="@drawable/ic_end_call"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
    
