<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:padding="24dp">

    <!-- Video surfaces, shown only after a voice -> video upgrade -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/surfaceVoiceRemoteVideo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/surfaceVoiceLocalVideo"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_marginTop="48dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Caller Avatar with cyan ring glow -->
    <ImageView
        android:id="@+id/ivCallAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_circle_cyan_glow"
        android:padding="28dp"
        android:src="@drawable/ic_person_light"
        android:contentDescription="Caller"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvCallName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Vikram Singh"
        android:textColor="@color/text_white"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivCallAvatar" />

    <TextView
        android:id="@+id/tvCallTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="02:15"
        android:textColor="@color/cyan_neon"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCallName" />

    <!-- Call Control Buttons Grid -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintBottom_toTopOf="@+id/layoutEndCall"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCallTimer">

        <!-- Speaker (active = cyan filled) -->
        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_margin="16dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/btnSpeaker"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_cyan_fill"
                android:padding="16dp"
                android:src="@drawable/ic_speaker_dark"
                android:contentDescription="Speaker" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Speaker"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Mute -->
        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_margin="16dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/btnMute"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_control"
                android:padding="16dp"
                android:src="@drawable/ic_mic_off"
                android:contentDescription="Mute" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Mute"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Video Toggle -->
        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_margin="16dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/btnVideoToggle"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_control"
                android:padding="16dp"
                android:src="@drawable/ic_video"
                android:contentDescription="Video" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Video"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Add Call (visual only, no conference logic yet) -->
        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_margin="16dp"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/btnAddCall"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_control"
                android:padding="16dp"
                android:src="@drawable/ic_add_call"
                android:contentDescription="Add Call" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Add Call"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>

    </GridLayout>

    <!-- Red End Call Button with label -->
    <LinearLayout
        android:id="@+id/layoutEndCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="26dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btnEndCall"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_red"
            android:padding="20dp"
            android:src="@drawable/ic_end_call"
            android:contentDescription="End Call" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="End Call"
            android:textColor="@color/text_white"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
