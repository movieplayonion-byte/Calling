<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08061F"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAuthTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login with Phone"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvAuthSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your mobile number to continue"
            android:textColor="#A0A3BD"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/tvCountryCode"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="+91"
                android:textColor="#00E5FF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="#141136"
                android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:autofillHints="phone"
                android:background="#141136"
                android:hint="Enter 10-digit number"
                android:inputType="phone"
                android:maxLength="15"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E7191"
                android:textSize="16sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbTermsConditions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#00E5FF"
            android:text="I agree to the Terms &amp; Conditions and Privacy Policy"
            android:textColor="#D6D8E7"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnNextAuth"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#00E5FF"
            android:text="Next"
            android:textAllCaps="false"
            android:textColor="#08061F"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New user? "
                android:textColor="#A0A3BD"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGoToSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Create Account / Sign Up"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
