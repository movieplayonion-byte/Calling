<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_wprd_logo"
            android:contentDescription="WPRD logo" />

        <TextView
            android:id="@+id/tvAuthTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Welcome Back"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAuthSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Login with your number and password"
            android:textColor="#A7A9CC"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="26dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="Secure login" />

        <!-- Login step: number + password -->
        <LinearLayout
            android:id="@+id/layoutLoginSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="🇮🇳 +91 ▾"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="#6629D8F0" />

                <EditText
                    android:id="@+id/etPhoneNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="phone"
                    android:background="@null"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:maxLength="15"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A8DB0"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="password"
                    android:background="@null"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:maxLength="64"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A8DB0"
                    android:textSize="16sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbTermsConditions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:buttonTint="#29D8F0"
                android:text="By continuing, you agree to our Terms &amp; Privacy Policy"
                android:textColor="#D6D8E7"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#29D8F0"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="#150A4A"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:padding="6dp"
                android:text="Forgot password?"
                android:textColor="#29D8F0"
                android:textSize="14sp" />
        </LinearLayout>
        <!-- /layoutLoginSection -->

        <!-- Forgot-password OTP step -->
        <LinearLayout
            android:id="@+id/layoutOtpSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvOtpInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Enter the OTP sent to your number"
                android:textColor="#A7A9CC"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etOtpCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:hint="OTP"
                android:inputType="number"
                android:maxLength="8"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8DB0"
                android:textSize="18sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnVerifyOtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#29D8F0"
                android:text="Verify OTP"
                android:textAllCaps="false"
                android:textColor="#150A4A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvResendOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="6dp"
                android:text="Resend OTP"
                android:textColor="#29D8F0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="6dp"
                android:text="Login par wapas jayein"
                android:textColor="#A7A9CC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <!-- /layoutOtpSection -->

        <!-- Forgot-password: naya password step -->
        <LinearLayout
            android:id="@+id/layoutResetSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:hint="New Password (min 6 characters)"
                android:inputType="textPassword"
                android:maxLength="64"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8DB0"
                android:textSize="16sp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/etConfirmNewPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:hint="Confirm New Password"
                android:inputType="textPassword"
                android:maxLength="64"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8DB0"
                android:textSize="16sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#29D8F0"
                android:text="Set New Password"
                android:textAllCaps="false"
                android:textColor="#150A4A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />
        </LinearLayout>
        <!-- /layoutResetSection -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New user? "
                android:textColor="#A7A9CC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGoToSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Create Account / Sign Up"
                android:textColor="#29D8F0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="26dp"
            android:alpha="0.45"
            android:src="@drawable/ic_wprd_logo"
            android:contentDescription="WPRD" />

    </LinearLayout>
</ScrollView>
