<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_wprd_logo"
            android:contentDescription="WPRD logo" />

        <TextView
            android:id="@+id/tvSignUpTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Create Account"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSignUpSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Ek OTP se number verify karo, phir password set karo"
            android:textColor="#A7A9CC"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="26dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="Secure sign up" />

        <!-- Step 1: naam + number -->
        <LinearLayout
            android:id="@+id/layoutFormSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:hint="Your Name"
                android:inputType="textPersonName"
                android:maxLength="50"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8DB0"
                android:textSize="16sp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="🇮🇳 +91 ▾"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="#6629D8F0" />

                <EditText
                    android:id="@+id/etPhoneNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="phone"
                    android:background="@null"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:maxLength="15"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8A8DB0"
                    android:textSize="16sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbTermsConditions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:buttonTint="#29D8F0"
                android:text="By continuing, you agree to our Terms &amp; Privacy Policy"
                android:textColor="#D6D8E7"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#29D8F0"
                android:text="Send OTP"
                android:textAllCaps="false"
                android:textColor="#150A4A"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />
        </LinearLayout>
        <!-- /layoutFormSection -->

        <!-- Step 2: OTP -->
        <LinearLayout
            android:id="@+id/layoutOtpSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvOtpInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Enter the OTP sent to your number"
                android:textColor="#A7A9CC"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etOtpCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:hint="OTP"
                android:inputType="number"
                android:maxLength="8"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8DB0"
                android:textSize="18sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnVerifyOtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#29D8F0"
                android:text="Verify OTP"
                android:textAllCaps="false"
                android:textColor="#150A4A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvResendOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="6dp"
                android:text="Resend OTP"
                android:textColor="#29D8F0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvChangeNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="6dp"
                android:text="Galat number? Number badlein"
                android:textColor="#A7A9CC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <!-- /layoutOtpSection -->

        <!-- Step 3: password set karo -->
        <LinearLayout
            android:id="@+id/layoutPasswordSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:hint="Password (min 6 characters)"
                android:inputType="textPassword"
                android:maxLength="64"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8DB0"
                android:textSize="16sp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:maxLength="64"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8DB0"
                android:textSize="16sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#29D8F0"
                android:text="Create Account"
                android:textAllCaps="false"
                android:textColor="#150A4A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />
        </LinearLayout>
        <!-- /layoutPasswordSection -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#A7A9CC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Login"
                android:textColor="#29D8F0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
